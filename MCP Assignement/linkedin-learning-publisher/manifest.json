{
  "manifest_version": "0.4",
  "name": "LinkedIn Learning Publisher",
  "version": "1.0.0",
  "description": "An MCP server that converts daily learning into LinkedIn posts.",
  "server": {
    "type": "uv",
    "entry_point": "server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "--directory",
        "${__dirname}",
        "run",
        "server.py"
      ],
      "env": {}
    }
  }
}
